@model QrYoklama.Models.ViewModels.StudentScanViewModel

@{
    ViewData["Title"] = "Yoklama QR Tarama";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Yoklama QR Tarama</h5>
                </div>
                <div class="card-body">
                    <p class="mb-3">Aşağıdaki bilgileri kontrol edip öğrenci numaranızı girin.</p>
                    <dl class="row mb-4">
                        <dt class="col-sm-4">Ders</dt>
                        <dd class="col-sm-8">@Model.LessonName</dd>
                        <dt class="col-sm-4">Derslik</dt>
                        <dd class="col-sm-8">@Model.Room</dd>
                        <dt class="col-sm-4">Saat</dt>
                        <dd class="col-sm-8">@Model.Time</dd>
                    </dl>

                    <div class="mb-3">
                        <label for="studentNumber" class="form-label">Öğrenci Numarası</label>
                        <input id="studentNumber" type="text" class="form-control" placeholder="Örnek: 221004001" />
                    </div>
                    <button id="btnSubmit" class="btn btn-success w-100">Yoklamaya Katıl</button>

                    <div id="resultMessage" class="mt-4 d-none alert" role="alert"></div>
                    <div id="attendanceDetails" class="mt-3 d-none"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const btn = document.getElementById('btnSubmit');
            const resultMessage = document.getElementById('resultMessage');
            const studentNumberInput = document.getElementById('studentNumber');

            btn.addEventListener('click', function (e) {
                e.preventDefault();

                const studentNumber = studentNumberInput.value.trim();
                if (!studentNumber) {
                    resultMessage.className = 'alert alert-warning';
                    resultMessage.innerText = 'Lütfen öğrenci numaranızı girin.';
                    resultMessage.classList.remove('d-none');
                    return;
                }

                fetch('/api/attendance/scan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        lessonName: @System.Text.Json.JsonSerializer.Serialize(Model.LessonName),
                        room: @System.Text.Json.JsonSerializer.Serialize(Model.Room),
                        time: @System.Text.Json.JsonSerializer.Serialize(Model.Time),
                        studentNumber: studentNumber,
                        deviceInfo: navigator.userAgent
                    })
                })
                .then(async res => {
                    const data = await res.json();
                    if (!res.ok) throw new Error(data?.message || 'Yoklama kaydı alınamadı.');

                    const details = document.getElementById('attendanceDetails');
                    const lesson = data.lesson || {};
                    const student = data.student || {};

                    resultMessage.className = 'alert alert-success';
                    resultMessage.innerText = data.message || 'Yoklama kaydınız alındı.';
                    resultMessage.classList.remove('d-none');

                    details.className = 'card card-body bg-light border mt-3';
                    details.innerHTML = `
                        <h6 class="mb-3">Yoklama Detayları</h6>
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Öğrenci</dt>
                            <dd class="col-sm-8">${student.name || studentNumber} (${student.number || studentNumber})</dd>

                            <dt class="col-sm-4">Ders</dt>
                            <dd class="col-sm-8">${lesson.name || '@Model.LessonName'}</dd>

                            <dt class="col-sm-4">Derslik</dt>
                            <dd class="col-sm-8">${lesson.room || '@Model.Room'}</dd>

                            <dt class="col-sm-4">Saat</dt>
                            <dd class="col-sm-8">${lesson.time || '@Model.Time'}</dd>

                            <dt class="col-sm-4">Zaman</dt>
                            <dd class="col-sm-8">${data.scanTime || ''} ${data.date || ''}</dd>
                        </dl>
                    `;
                    details.classList.remove('d-none');

                    btn.disabled = true;
                    studentNumberInput.disabled = true;
                })
                .catch(err => {
                    resultMessage.className = 'alert alert-danger';
                    resultMessage.innerText = err.message;
                    resultMessage.classList.remove('d-none');
                });
            });
        });
    </script>
}
