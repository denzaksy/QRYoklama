@model List<string>

@{
    ViewData["Title"] = "Hoca Yoklama Paneli";
    var derslikler = ViewBag.Derslikler as List<string>;
    var dersSaatleri = ViewBag.DersSaatleri as List<string>;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0">Hoş geldiniz, @ViewBag.TeacherName</h5>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light btn-sm">Çıkış Yap</button>
                    </form>
                </div>
                
                <div class="card-body text-center p-4">
                    <p class="text-muted mb-4">Lütfen yoklama başlatılacak ders, derslik ve saat bilgilerini seçiniz.</p>
                    
                    <div class="row g-3 text-start mb-4">
                        <div class="col-md-12">
                            <label for="courseSelect" class="form-label fw-bold text-secondary">Ders Adı</label>
                            <select id="courseSelect" class="form-select form-select-lg">
                                <option value="">-- Dersi Seçiniz --</option>
                                @if (Model != null)
                                {
                                    foreach (var ders in Model)
                                    {
                                        <option value="@ders">@ders</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="roomSelect" class="form-label fw-bold text-secondary">Derslik / Sınıf</label>
                            <select id="roomSelect" class="form-select">
                                <option value="">-- Lab veya Sınıf Seçiniz --</option>
                                @if (derslikler != null)
                                {
                                    foreach (var sınıf in derslikler)
                                    {
                                        <option value="@sınıf">@sınıf</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="timeSelect" class="form-label fw-bold text-secondary">Ders Saati</label>
                            <select id="timeSelect" class="form-select">
                                <option value="">-- Saat Aralığı Seçiniz --</option>
                                @if (dersSaatleri != null)
                                {
                                    foreach (var saat in dersSaatleri)
                                    {
                                        <option value="@saat">@saat</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <button id="btnGenerate" class="btn btn-success btn-lg w-100 py-2 shadow-sm fw-bold">
                        <i class="bi bi-qr-code"></i> Yoklama İçin QR Kod Oluştur
                    </button>

                    <div id="qrArea" class="mt-4 d-none">
                        <hr class="my-4">
                        <div class="alert alert-info py-2" role="alert">
                            <h5 class="alert-heading mb-1" id="qrTitle"></h5>
                            <p class="mb-0 small" id="qrSubTitle"></p>
                        </div>
                        <div class="d-flex justify-content-center my-3">
                            <div id="qrcode" class="p-3 bg-white border rounded shadow-sm"></div>
                        </div>
                        <p class="text-danger small fw-bold">* Öğrenciler bu QR kodu sistem üzerinden taratarak yoklamaya katılır.</p>
                        
                        <div class="mt-5 text-start">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold text-secondary m-0"><i class="bi bi-people-fill text-primary"></i> Dersteki Öğrenciler</h5>
                                <span class="badge bg-primary fs-6" id="attendanceCount">Toplam: 0 Öğrenci</span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover border align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Öğrenci No</th>
                                            <th>Adı Soyadı</th>
                                            <th>Giriş Saati</th>
                                            <th>Durum</th>
                                        </tr>
                                    </thead>
                                    <tbody id="attendanceList">
                                        <tr id="noRecordsRow">
                                            <td colspan="4" class="text-center text-muted py-4">Henüz QR kod taratan öğrenci olmadı. Yoklama bekleniyor...</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btn = document.getElementById("btnGenerate");
        let studentCount = 0;
        let signalrConnected = false;
        let connection = null;

        if (btn) {
            btn.addEventListener("click", function (e) {
                e.preventDefault(); 

                const selectedCourse = document.getElementById("courseSelect").value;
                const selectedRoom = document.getElementById("roomSelect").value;
                const selectedTime = document.getElementById("timeSelect").value;

                if (!selectedCourse || !selectedRoom || !selectedTime) {
                    alert("Lütfen tüm seçimleri (Ders, Derslik ve Saat) eksiksiz yapın!");
                    return;
                }

                const timestamp = new Date().getTime();
                const lessonGroup = selectedCourse;
                const scanUrl = `${window.location.origin}/Student/Scan?lessonName=${encodeURIComponent(selectedCourse)}&room=${encodeURIComponent(selectedRoom)}&time=${encodeURIComponent(selectedTime)}&token=${timestamp}`;
                const qrData = scanUrl;

                const qrArea = document.getElementById("qrArea");
                
                if (qrArea) {
                    qrArea.classList.remove("d-none");
                    document.getElementById("qrTitle").innerText = `${selectedCourse} - Yoklama Başlatıldı`;
                    document.getElementById("qrSubTitle").innerText = `Konum: ${selectedRoom} | Zaman Dilimi: ${selectedTime}`;

                    // Sunucudan gerçek PNG QR oluşturma
                    const canvasContainer = document.getElementById("qrcode");
                    canvasContainer.innerHTML = ''; 

                    fetch('/api/qr/generate', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ payload: qrData })
                    })
                    .then(res => {
                        if (!res.ok) throw new Error('QR oluşturulamadı');
                        return res.blob();
                    })
                    .then(blob => {
                        const url = URL.createObjectURL(blob);
                        canvasContainer.innerHTML = `<img src="${url}" width="220" height="220" alt="QR Kod"/>`;
                    })
                    .catch(err => {
                        console.error(err);
                        alert('Sunucudan QR oluşturulamadı. Konsolu kontrol edin.');
                    });

                    // SignalR Bağlantısı
                    if (!signalrConnected) {
                        connection = new signalR.HubConnectionBuilder()
                            .withUrl("/attendanceHub")
                            .withAutomaticReconnect()
                            .build();

                        connection.on("ReceiveAttendance", function (studentNo, studentName, scanTime) {
                            const noRecordsRow = document.getElementById("noRecordsRow");
                            if (noRecordsRow) noRecordsRow.remove();

                            const list = document.getElementById("attendanceList");
                            
                            if (!document.getElementById(`student-${studentNo}`)) {
                                studentCount++;
                                document.getElementById("attendanceCount").innerText = `Toplam: ${studentCount} Öğrenci`;

                                const row = document.createElement("tr");
                                row.id = `student-${studentNo}`;
                                row.className = "table-success";
                                
                                row.innerHTML = `
                                    <td class="fw-bold">${studentNo}</td>
                                    <td>${studentName}</td>
                                    <td>${scanTime}</td>
                                    <td><span class="badge bg-success">Geldi</span></td>
                                `;
                                
                                list.insertBefore(row, list.firstChild);

                                setTimeout(() => { row.className = ""; }, 3000);
                            }
                        });

                        connection.start()
                            .then(() => {
                                console.log("SignalR Bağlantısı Başarılı!");
                                return connection.invoke("JoinLessonRoom", lessonGroup);
                            })
                            .then(() => {
                                signalrConnected = true;
                            })
                            .catch(err => console.error("SignalR Bağlantı Hatası: ", err));
                    }
                }
            });
        }
    });
</script>